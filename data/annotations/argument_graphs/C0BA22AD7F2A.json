  "units": [
    {
      "id": "a1",
      "start": 0,
      "end": 56,
      "text": "Why should people who be qualified be only able to vote?",
      "role": "lead",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "a2",
      "start": 57,
      "end": 165,
      "text": "Voting should be for everyone, not such as anyone like as in Gang related people or people who are in prison",
      "role": "lead",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "a4",
      "start": 166,
      "end": 188,
      "text": "but you get the point.",
      "role": "lead",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "a5",
      "start": 189,
      "end": 356,
      "text": "This '' Electoral College '' experiment that they already have been going on is just something that they can use to get more time to think out what their next move is.",
      "role": "lead",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "a6",
      "start": 357,
      "end": 549,
      "text": "They way certaint people, like me, see things like if the One out of the other person who is running for President and his votes come back with such little insufficient votes like 87% to 89.5%",
      "role": "lead",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "a7",
      "start": 550,
      "end": 606,
      "text": "the should continue the vote and the show must continue!",
      "role": "lead",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "a8",
      "start": 607,
      "end": 677,
      "text": "Even though the ''Electoral College'' seems like just a waste of time,",
      "role": "lead",
      "stance": "conceded",
      "polarity": "positive"
    },
    {
      "id": "a9",
      "start": 678,
      "end": 696,
      "text": "does it even work?",
      "role": "lead",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "r1",
      "start": 698,
      "end": 745,
      "text": "Electoral College doesn't really prove anything",
      "role": "position",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "r2",
      "start": 746,
      "end": 828,
      "text": "because some people won votes and lost the presidency,thanks to electoral college.",
      "role": "position",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "r3",
      "start": 829,
      "end": 934,
      "text": "Due to the elctoral college system, voters vote not for the president but just for the slate of electors,",
      "role": "claim",
      "stance": "endorsed",
      "polarity": "positive"
    },
    {
      "id": "r4",
      "start": 935,
      "end": 969,
      "text": "who then turn elect the president.",
      "role": "claim",
      "stance": "endorsed",
      "polarity": "positive"
    }
  ],
